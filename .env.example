# Vercel Production (id.bankayo.io). Set these in Project → Environment Variables.
# Do not put VPS Postgres / KEYCLOAK_ADMIN / KC_* here.

AUTH_SECRET=
AUTH_URL=https://id.bankayo.io
AUTH_KEYCLOAK_ID=keycloak-ui
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://auth.bankayo.io/realms/master

KEYCLOAK_URL=https://auth.bankayo.io
KEYCLOAK_REALM=app
# Optional. Used when ensuring keycloak-ui on a SACCO realm (Fineract UI officers).
# FINERACT_UI_URL=https://app.bankayo.io
